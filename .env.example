# Copie para .env (que nunca vai para o git) e troque os dois valores TROCAR_...
# O serviço recusa subir com qualquer um deles.

# Porta do Javalin. O compose publica 127.0.0.1:8082:8082, e o Core API espera a 8082
# (EXTERNAL_DATA_SERVICE_URL), então mantenha 8082.
SERVER_PORT=8082

# Chave compartilhada: o Core API a envia em X-Service-Key.
# Use o mesmo SERVICE_KEY configurado no Core API.
SERVICE_KEY=TROCAR_mesmo_valor_do_core_api

# Chave do plano Demo da CoinGecko, enviada no cabeçalho x-cg-demo-api-key.
COINGECKO_API_KEY=TROCAR_chave_do_plano_demo_da_coingecko

# Base da CoinGecko (os testes apontam para um servidor falso local)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Prazo total de cada chamada à CoinGecko, em segundos, de 1 a 6 (seção 6 do desenho):
# o CT18 faz duas chamadas em sequência e o Core API espera até 15 s.
COINGECKO_TIMEOUT_SECONDS=6
